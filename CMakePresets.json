{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "x64-debug",
            "displayName": "Windows x64 Debug",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "x64-release",
            "displayName": "Windows x64 Release",
            "inherits": "x64-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "x64-asan",
            "displayName": "Windows x64, AddressSanitizer + UndefinedBehaviorSanitizer",
            "description": "ASan does not support the Debug CRT on Windows, so this builds against the release CRT and libraries, with asserts on.",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O1 -g -Xclang -gcodeview",
                "RASM_SANITIZERS": "address;undefined"
            }
        },
        {
            "name": "x64-tidy",
            "displayName": "Windows x64 Debug, clang-tidy on every compile",
            "inherits": "x64-debug",
            "cacheVariables": {
                "CMAKE_CXX_CLANG_TIDY": "clang-tidy"
            }
        },
        {
            "name": "macOS-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "macOS",
            "displayName": "macOS native Debug",
            "inherits": "macOS-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macOS-release",
            "displayName": "macOS native Release",
            "inherits": "macOS",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macOS-asan",
            "displayName": "macOS Debug, AddressSanitizer + UndefinedBehaviorSanitizer",
            "inherits": "macOS",
            "cacheVariables": {
                "RASM_SANITIZERS": "address;undefined"
            }
        },
        {
            "name": "macOS-tsan",
            "displayName": "macOS Debug, ThreadSanitizer",
            "inherits": "macOS",
            "cacheVariables": {
                "RASM_SANITIZERS": "thread"
            }
        },
        {
            "name": "macOS-tidy",
            "displayName": "macOS Debug, clang-tidy on every compile",
            "inherits": "macOS",
            "cacheVariables": {
                "CMAKE_CXX_CLANG_TIDY": "clang-tidy"
            }
        },
        {
            "name": "macOS-Xcode",
            "displayName": "macOS native Xcode",
            "inherits": "macOS-base",
            "generator": "Xcode"
        }
    ],
    "buildPresets": [
        {
            "name": "x64-debug",
            "configurePreset": "x64-debug"
        },
        {
            "name": "x64-release",
            "configurePreset": "x64-release"
        },
        {
            "name": "x64-asan",
            "configurePreset": "x64-asan"
        },
        {
            "name": "x64-tidy",
            "configurePreset": "x64-tidy"
        },
        {
            "name": "macOS",
            "configurePreset": "macOS"
        },
        {
            "name": "macOS-release",
            "configurePreset": "macOS-release"
        },
        {
            "name": "macOS-asan",
            "configurePreset": "macOS-asan"
        },
        {
            "name": "macOS-tsan",
            "configurePreset": "macOS-tsan"
        },
        {
            "name": "macOS-tidy",
            "configurePreset": "macOS-tidy"
        },
        {
            "name": "macOS-Xcode",
            "configurePreset": "macOS-Xcode",
            "configuration": "Debug"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "x64-debug",
            "inherits": "test-base",
            "configurePreset": "x64-debug"
        },
        {
            "name": "x64-release",
            "inherits": "test-base",
            "configurePreset": "x64-release"
        },
        {
            "name": "x64-asan",
            "inherits": "test-base",
            "configurePreset": "x64-asan",
            "environment": {
                "UBSAN_OPTIONS": "print_stacktrace=1"
            }
        },
        {
            "name": "macOS",
            "inherits": "test-base",
            "configurePreset": "macOS"
        },
        {
            "name": "macOS-release",
            "inherits": "test-base",
            "configurePreset": "macOS-release"
        },
        {
            "name": "macOS-asan",
            "inherits": "test-base",
            "configurePreset": "macOS-asan",
            "environment": {
                "UBSAN_OPTIONS": "print_stacktrace=1"
            }
        },
        {
            "name": "macOS-tsan",
            "inherits": "test-base",
            "configurePreset": "macOS-tsan",
            "environment": {
                "TSAN_OPTIONS": "halt_on_error=1"
            }
        },
        {
            "name": "macOS-Xcode",
            "inherits": "test-base",
            "configurePreset": "macOS-Xcode",
            "configuration": "Debug"
        }
    ]
}
