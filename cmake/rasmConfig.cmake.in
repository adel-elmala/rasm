@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# rasm is a static library, so its PRIVATE dependencies are link requirements for consumers too.
# Stb and tinygltf are absent because rasm only uses their headers.
find_dependency(Vulkan)
find_dependency(vk-bootstrap CONFIG)
find_dependency(VulkanMemoryAllocator CONFIG)
find_dependency(glm CONFIG)
find_dependency(SDL3 CONFIG)
find_dependency(Tracy CONFIG)
find_dependency(spdlog CONFIG)
find_dependency(tinyobjloader CONFIG)
find_dependency(slang CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/rasmTargets.cmake")

check_required_components(rasm)
