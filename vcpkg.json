{
    "name": "rasm",
    "version": "0.1.0",
    "dependencies": [
        "volk",
        "vulkan-headers",
        "vk-bootstrap",
        "vulkan-memory-allocator",
        "glm",
        {
            "name": "sdl3",
            "features": ["vulkan"]
        },
        {
            "name": "tracy",
            "features": ["on-demand"]
        },
        "stb",
        "spdlog",
        "tinygltf",
        "tinyobjloader",
        "meshoptimizer",
        "ktx",
        "shader-slang",
        "doctest"
    ],
    "features": {
        "imgui": {
            "description": "Dear ImGui for the engine's debug window and the application's UI (CMake option RASM_IMGUI)",
            "dependencies": [
                {
                    "name": "imgui",
                    "features": ["sdl3-binding"]
                }
            ]
        }
    }
}
