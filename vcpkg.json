{
    "name": "rasm",
    "version": "0.1.0",
    "dependencies": [
        "volk",
        "vulkan-headers",
        "vk-bootstrap",
        "vulkan-memory-allocator",
        "glm",
        "sdl3",
        {
            "name": "tracy",
            "features": ["on-demand"]
        },
        "stb",
        "spdlog",
        "tinygltf",
        "tinyobjloader",
        "meshoptimizer",
        "ktx",
        "shader-slang",
        "doctest",
        "earcut-hpp",
        "laszip",
        "zlib"
    ],
    "features": {
        "imgui": {
            "description": "Dear ImGui for the engine's debug window and the application's UI (CMake option RASM_IMGUI)",
            "dependencies": [
                "imgui"
            ]
        }
    }
}
